<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- String constants -->
  <?define ProductName="SecureWall" ?>
  <?define Manufacturer="Károly Pados and SecureWall contributors" ?>
  <?define Description="A default-deny Windows firewall with explicit outbound prompts." ?>
  <?define ProductVersion="!(bind.fileVersion.SecureWallEXE)" ?>
  <!-- v0.5.0 is the first package whose own removal can run inside another package's
       upgrade: v0.4.2 and older carry a NOT UPGRADINGPRODUCTCODE launch condition in
       their cached packages, so they need one explicit uninstall. -->
  <?define OldestUpgradeableVersion="0.5.0" ?>
  <!-- MsiSetup.wixproj sets PreUpgradeVersion only while TinyWall.csproj's <Version> is
       below 0.5.0 (development builds before the v0.5.0 bump). The floor then equals the
       product version and the upgradeable row is left out, because ICE61 rejects an
       empty range: no older version is upgradeable and every older one is refused. -->
  <?ifdef PreUpgradeVersion ?>
    <?undef OldestUpgradeableVersion ?>
    <?define OldestUpgradeableVersion="$(var.PreUpgradeVersion)" ?>
  <?endif ?>

  <!-- Architecture selection -->
  <?if $(var.Platform) = x64 ?>
    <?define BuildArch="x64" ?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?define NgenBitness = "64bit" ?>
    <?define System32Dir = "System64Folder" ?>
  <?elseif $(var.Platform) = "arm64"?>
	<?define BuildArch="arm64" ?>
	<?define Win64 = "yes" ?>
	<?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
	<?define NgenBitness = "64bit" ?>
	<?define System32Dir = "System64Folder" ?>
  <?elseif $(var.Platform) = "x86"?>
    <?define BuildArch="x86" ?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?define NgenBitness = "32bit" ?>
    <?define System32Dir = "SystemFolder" ?>
  <?endif ?>

  <Product Id="*" Codepage="1250" Name="$(var.ProductName)" Language="1033" Version="$(var.ProductVersion)" Manufacturer="$(var.Manufacturer)" UpgradeCode="{D257A00C-9D9B-4948-910F-5524F20819D0}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" SummaryCodepage="1250" Description="$(var.Description)" Manufacturer="$(var.Manufacturer)" />

    <!-- Automatic media generation and assignment -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs -->
    <Property Id="ARPPRODUCTICON" Value="SecureWallIcon.exe" />
    <Property Id="ARPCOMMENTS" Value="$(var.Description)" />
    <Property Id="ARPCONTACT" Value="$(var.Manufacturer)" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" /> 
    <!-- Removal inside a newer package's upgrade (UPGRADINGPRODUCTCODE) passes this:
         Installed and REMOVE="ALL". -->
    <Condition Message="Repair and modification are not supported yet. Remove SecureWall explicitly, then install again.">
      <![CDATA[NOT Installed OR (REMOVE="ALL" AND NOT REINSTALL)]]>
    </Condition>
    <Condition Message="Rollback must be enabled to install or remove SecureWall safely.">
      <![CDATA[NOT RollbackDisabled]]>
    </Condition>
    <Property Id="EXISTINGSECUREWALLSERVICE" Secure="yes">
      <RegistrySearch Id="ExistingSecureWallService" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\SecureWall" Name="ImagePath" Type="raw" />
    </Property>
    <Property Id="SECUREWALLDELETEPENDING" Secure="yes">
      <RegistrySearch Id="SecureWallDeletePending" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\SecureWall" Name="DeleteFlag" Type="raw" />
    </Property>
    <Condition Message="SecureWall service deletion is pending. Close Services and other service-management tools, or restart Windows, before installing again.">
      <![CDATA[Installed OR SECUREWALLDELETEPENDING <> "#1"]]>
    </Condition>
    <!-- An upgrade keeps the existing service registration; /msi-upgrade-start still
         proves it belongs to this installation before starting it. -->
    <Condition Message="An existing SecureWall service must be removed with its original installer before a fresh installation. If it was already removed, close service-management tools or restart Windows first.">
      <![CDATA[Installed OR OLDER_UPGRADEABLE_FOUND OR (NOT EXISTINGSECUREWALLSERVICE AND SECUREWALLDELETEPENDING <> "#1")]]>
    </Condition>
    <CustomAction Id="SetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />

    <?ifdef UpgradeFaultTest ?>
      <!-- UpgradeFaultTest configuration only. The installer contract test refuses
           any release package that carries this property. -->
      <Property Id="SECUREWALLUPGRADEFAULTTEST" Value="1" />
    <?endif ?>

    <!-- Always write a verbose Windows Installer log to %TEMP% (MSI*.LOG). Its path is
         MsiLogFileLocation, which the failure page offers to open. -->
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <!-- Disable use of "Files in Use" dialogs, we manage that ourself over custom actions -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- Windows version detection -->
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="BuildNumberSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Condition Message="This application requires Windows 10 version 21H2 (build 19044) or newer.">
      <![CDATA[Installed OR (WINDOWSBUILDNUMBER >= 19044)]]>
    </Condition>

    <!-- .Net Framework detection -->
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED"/>
    <Condition Message='This application requires .NET Framework 4.8 to be installed.'>
      <![CDATA[WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED]]>
    </Condition>

    <!-- Never layer SecureWall over TinyWall. The elevated /install path repeats
         this check against the Service Control Manager before activating WFP. -->
    <Property Id="TINYWALLINSTALLDIR32" Secure="yes">
      <RegistrySearch Id="TinyWallInstallDir32" Root="HKLM" Key="Software\TinyWall" Name="InstallDir" Type="raw" Win64="no" />
    </Property>
    <?if $(var.Platform) != x86 ?>
      <Property Id="TINYWALLINSTALLDIR64" Secure="yes">
        <RegistrySearch Id="TinyWallInstallDir64" Root="HKLM" Key="Software\TinyWall" Name="InstallDir" Type="raw" Win64="yes" />
      </Property>
    <?endif ?>
    <Condition Message="TinyWall is installed. Keep TinyWall active for now; install SecureWall only after SecureWall has passed VM testing, then uninstall TinyWall and reboot first.">
      <?if $(var.Platform) = x86 ?>
        <![CDATA[Installed OR (NOT TINYWALLINSTALLDIR32)]]>
      <?else ?>
        <![CDATA[Installed OR (NOT TINYWALLINSTALLDIR32 AND NOT TINYWALLINSTALLDIR64)]]>
      <?endif ?>
    </Condition>

    <!-- Feature description -->
    <Feature Id="ProductFeature" Title="Complete" Description="The complete package." ConfigurableDirectory="INSTALLDIR" Level="1">
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='MainExecutableConfig' />
      <ComponentRef Id='ProgramMenuDir' />
      <ComponentRef Id='RegistryKeys' />
      <ComponentRef Id='EventLogSource' />
      <ComponentRef Id='License' />
      <ComponentRef Id='Attributions' />
      <ComponentRef Id='Database' />
      <ComponentRef Id='hosts' />
      <ComponentGroupRef Id='Dependencies' />
      <ComponentGroupRef Id='Localizations' />
      <ComponentGroupRef Id='Documentation' />
    </Feature>

    <!-- Search for older versions -->
    <Property Id="OLDER_INCOMPATIBLE_FOUND" Secure="yes" />
    <Property Id="OLDER_UPGRADEABLE_FOUND" Secure="yes" />
    <Property Id="SELF_FOUND" Secure="yes" />
    <Property Id="NEWER_FOUND" Secure="yes" />
    <!-- A manual table instead of <MajorUpgrade>: that element cannot refuse an
         equal-version rebuild, which has a new ProductCode and would otherwise install
         side by side. Windows Installer compares only the first three version fields,
         so every release changes one of them. Only the older upgradeable range is
         removed, by RemoveExistingProducts in the same transaction. -->
    <Upgrade Id='{D257A00C-9D9B-4948-910F-5524F20819D0}'>
      <UpgradeVersion OnlyDetect='yes' Property='OLDER_INCOMPATIBLE_FOUND'
        Maximum="$(var.OldestUpgradeableVersion)" IncludeMaximum='no' />
      <?ifndef PreUpgradeVersion ?>
      <UpgradeVersion OnlyDetect='no' MigrateFeatures='yes' Property='OLDER_UPGRADEABLE_FOUND'
        Minimum="$(var.OldestUpgradeableVersion)" IncludeMinimum='yes'
        Maximum="$(var.ProductVersion)" IncludeMaximum='no' />
      <?endif ?>
      <UpgradeVersion OnlyDetect='yes' Property='SELF_FOUND'
        Minimum="$(var.ProductVersion)" IncludeMinimum='yes'
        Maximum="$(var.ProductVersion)" IncludeMaximum='yes' />
      <UpgradeVersion OnlyDetect='yes' Property='NEWER_FOUND'
        Minimum="$(var.ProductVersion)" IncludeMinimum='no' />
    </Upgrade>
    <Condition Message="This version of SecureWall is already installed. Repair and reinstallation are not supported. Remove SecureWall explicitly, then install again.">
      <![CDATA[Installed OR NOT SELF_FOUND]]>
    </Condition>
    <Condition Message="An installed SecureWall version cannot be replaced by this package. Remove it explicitly, then install again.">
      <![CDATA[Installed OR (NOT OLDER_INCOMPATIBLE_FOUND AND NOT NEWER_FOUND)]]>
    </Condition>

    <!-- An upgrade installs into the directory the installed version recorded, for the
         same platform. The service ImagePath points there, and /msi-upgrade-start refuses
         any other executable. Each package reads its own registry view, so an x86 package
         never finds a 64-bit installation and the reverse; both are refused here. -->
    <Property Id="UPGRADEINSTALLDIR" Secure="yes">
      <RegistrySearch Id="UpgradeInstallDir" Root="HKLM" Key="Software\SecureWall" Name="InstallDir" Type="raw" Win64="$(var.Win64)" />
    </Property>
    <Property Id="UPGRADEPLATFORM" Secure="yes">
      <RegistrySearch Id="UpgradePlatform" Root="HKLM" Key="Software\SecureWall" Name="Platform" Type="raw" Win64="$(var.Win64)" />
    </Property>
    <Condition Message="The installed SecureWall is for a different processor architecture, or its installation directory is not recorded. Remove it explicitly, then install this package.">
      Installed OR NOT OLDER_UPGRADEABLE_FOUND OR (UPGRADEINSTALLDIR AND UPGRADEPLATFORM = "$(var.BuildArch)")
    </Condition>
    <CustomAction Id="SetInstallDirFromRegistry" Property="INSTALLDIR" Value="[UPGRADEINSTALLDIR]" />

    <!-- Custom actions -->
    <CustomAction Id='FoundIncompatibleVersion' Error='An older version of $(var.ProductName) is installed that cannot be automatically updated. Please uninstall the existing version first, then try again.' />
    <CustomAction Id='FoundNewerVersion' Error='A newer version of $(var.ProductName) is already installed. Installation cannot continue.' />
    <CustomAction Id='InstallCustom' FileKey='SecureWallEXE' ExeCommand='/install' Return='check' Execute='deferred' Impersonate='no' />
    <CustomAction Id='InstallCustomRollback' FileKey='SecureWallEXE' ExeCommand='/msi-rollback-install' Return='check' Execute='rollback' Impersonate='no' />
    <CustomAction Id='UninstallCustom' FileKey='SecureWallEXE' ExeCommand='/msi-cleanup' Return='check' Execute='deferred' Impersonate='no' />
    <!-- File rollback precedes this reverse action because teardown precedes RemoveFiles.
         Rebuild saved protection; transient runtime grants are intentionally not restored. -->
    <CustomAction Id='UninstallCustomRollback' FileKey='SecureWallEXE' ExeCommand='/install' Return='check' Execute='rollback' Impersonate='no' />
    <CustomAction Id='StartControllerAndDetect' FileKey='SecureWallEXE' ExeCommand='/autowhitelist' Return='asyncNoWait' Execute='commit' />
    <CustomAction Id='StartController' FileKey='SecureWallEXE' ExeCommand='' Return='asyncNoWait' Execute='commit' />

    <!-- In-place upgrade. The transaction ID is the new package's ProductCode:
         [UPGRADINGPRODUCTCODE] inside the old package's removal, [ProductCode] inside
         the new package. docs/SECURITY.md "In-place upgrade" describes each step.
         Old package, run by RemoveExistingProducts: stop itself before RemoveFiles, and
         on rollback start itself again once its files are back. -->
    <CustomAction Id='UpgradeStop' FileKey='SecureWallEXE' ExeCommand='/msi-upgrade-stop [UPGRADINGPRODUCTCODE]' Return='check' Execute='deferred' Impersonate='no' />
    <CustomAction Id='UpgradeStopRollback' FileKey='SecureWallEXE' ExeCommand='/msi-upgrade-restore [UPGRADINGPRODUCTCODE]' Return='check' Execute='rollback' Impersonate='no' />
    <!-- New package: start itself after its files are in place, and on rollback stop
         itself before Windows Installer removes them. The commit step deletes the
         policy snapshot and the upgrade-in-progress marker; its failure cannot undo a
         finished upgrade, so it is not checked (event 1001 still records it). -->
    <CustomAction Id='UpgradeStart' FileKey='SecureWallEXE' ExeCommand='/msi-upgrade-start [ProductCode]' Return='check' Execute='deferred' Impersonate='no' />
    <CustomAction Id='UpgradeStartRollback' FileKey='SecureWallEXE' ExeCommand='/msi-upgrade-abort [ProductCode]' Return='check' Execute='rollback' Impersonate='no' />
    <CustomAction Id='UpgradeCommit' FileKey='SecureWallEXE' ExeCommand='/msi-upgrade-commit [ProductCode]' Return='ignore' Execute='commit' Impersonate='no' />

    <!-- Sequencing -->
    <InstallExecuteSequence>
      <!-- FindRelatedProducts -->
      <Custom Action='FoundNewerVersion' After='FindRelatedProducts'>NEWER_FOUND</Custom>
      <Custom Action='FoundIncompatibleVersion' After='FindRelatedProducts'>OLDER_INCOMPATIBLE_FOUND</Custom>
      <!-- AppSearch -->
      <Custom Action='SetInstallDirFromRegistry' After='AppSearch'>OLDER_UPGRADEABLE_FOUND AND UPGRADEINSTALLDIR AND NOT Installed</Custom>
      <!-- InstallValidate -->
      <Custom Action="SetARPINSTALLLOCATION" After="InstallValidate"></Custom>
      <!-- InstallInitialize: the old product's removal and this installation share one
           transaction and one rollback script. -->
      <RemoveExistingProducts After='InstallInitialize' />
      <!-- Old package, explicit removal or removal by a newer package's upgrade -->
      <Custom Action='UpgradeStopRollback' Before='UpgradeStop'>Installed AND REMOVE="ALL" AND UPGRADINGPRODUCTCODE</Custom>
      <Custom Action='UpgradeStop' Before='UninstallCustomRollback'>Installed AND REMOVE="ALL" AND UPGRADINGPRODUCTCODE</Custom>
      <Custom Action='UninstallCustomRollback' Before='UninstallCustom'>Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action='UninstallCustom' Before='UnpublishFeatures'>Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <!-- New package, fresh installation or upgrade -->
      <Custom Action='UpgradeCommit' Before='StartController'>NOT Installed AND OLDER_UPGRADEABLE_FOUND</Custom>
      <Custom Action='StartController' Before='UpgradeStartRollback'>NOT Installed AND OLDER_UPGRADEABLE_FOUND AND UILevel=5</Custom>
      <Custom Action='UpgradeStartRollback' Before='UpgradeStart'>NOT Installed AND OLDER_UPGRADEABLE_FOUND</Custom>
      <Custom Action='UpgradeStart' Before='InstallCustomRollback'>NOT Installed AND OLDER_UPGRADEABLE_FOUND</Custom>
      <Custom Action='InstallCustomRollback' Before='InstallCustom'>NOT Installed AND NOT OLDER_UPGRADEABLE_FOUND</Custom>
      <Custom Action='InstallCustom' Before='InstallFinalize'>NOT Installed AND NOT OLDER_UPGRADEABLE_FOUND</Custom>
      <Custom Action='StartControllerAndDetect' After='InstallCustom'>NOT Installed AND NOT OLDER_UPGRADEABLE_FOUND AND UILevel=5</Custom>
      <!-- InstallFinalize -->
    </InstallExecuteSequence>

    <!-- Sequencing -->
    <InstallUISequence>
      <Custom Action='FoundNewerVersion' After='FindRelatedProducts'>NEWER_FOUND</Custom>
      <Custom Action='FoundIncompatibleVersion' After='FoundNewerVersion'>OLDER_INCOMPATIBLE_FOUND</Custom>
      <Custom Action='SetInstallDirFromRegistry' After='AppSearch'>OLDER_UPGRADEABLE_FOUND AND UPGRADEINSTALLDIR AND NOT Installed</Custom>
    </InstallUISequence>

    <!-- UI definition and overrides -->
    <UIRef Id="WixUI_InstallDir_Custom" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="background.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="Sources\ProgramFiles\SecureWall\License.rtf" />

  </Product>

  <Fragment>

    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Program Files -->
      <Directory Id="$(var.PlatformProgramFilesFolder)" Name="ProgramFiles">
        <Directory Id="INSTALLDIR" Name="SecureWall">
          <Directory Id="DataDefaultsDir" Name="data-defaults">
            <Component Id="Database" Guid="*" Win64="$(var.Win64)">
              <File Id="DatabaseJson" Source="Sources\CommonAppData\SecureWall\profiles.json" Vital="yes" KeyPath="yes" />
            </Component>
            <Component Id="hosts" Guid="*" Win64="$(var.Win64)">
              <File Id="HostsBCK" Source="Sources\CommonAppData\SecureWall\hosts.bck" Vital="yes" KeyPath="yes" />
            </Component>
          </Directory>
          <Component Id="MainExecutable" Guid="*" Win64="$(var.Win64)">
            <File Id="SecureWallEXE" Source="Sources\ProgramFiles\SecureWall\SecureWall.exe" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="MainExecutableConfig" Guid="*" Win64="$(var.Win64)">
            <File Id="SecureWallCONFIG" Source="Sources\ProgramFiles\SecureWall\SecureWall.exe.config" KeyPath="yes" />
          </Component>
          <Component Id="Microsoft_Bcl_AsyncInterfaces_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="Microsoft_Bcl_AsyncInterfaces_dll" Source="Sources\ProgramFiles\SecureWall\Microsoft.Bcl.AsyncInterfaces.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Buffers_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Buffers_dll" Source="Sources\ProgramFiles\SecureWall\System.Buffers.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_IO_Pipelines_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_IO_Pipelines_dll" Source="Sources\ProgramFiles\SecureWall\System.IO.Pipelines.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Memory_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Memory_dll" Source="Sources\ProgramFiles\SecureWall\System.Memory.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Numerics_Vectors_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Numerics_Vectors_dll" Source="Sources\ProgramFiles\SecureWall\System.Numerics.Vectors.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Runtime_CompilerServices_Unsafe_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Runtime_CompilerServices_Unsafe_dll" Source="Sources\ProgramFiles\SecureWall\System.Runtime.CompilerServices.Unsafe.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Text_Encodings_Web_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Text_Encodings_Web_dll" Source="Sources\ProgramFiles\SecureWall\System.Text.Encodings.Web.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Text_Json_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Text_Json_dll" Source="Sources\ProgramFiles\SecureWall\System.Text.Json.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="System_Threading_Tasks_Extensions_Lib" Guid="*" Win64="$(var.Win64)">
            <File Id="System_Threading_Tasks_Extensions_dll" Source="Sources\ProgramFiles\SecureWall\System.Threading.Tasks.Extensions.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
          </Component>
          <Component Id="License" Guid="*" Win64="$(var.Win64)">
            <File Id="LicenseRTF" Source="Sources\ProgramFiles\SecureWall\License.rtf" KeyPath="yes" />
          </Component>
          <Component Id="Attributions" Guid="*" Win64="$(var.Win64)">
            <File Id="AttributionsTXT" Source="Sources\ProgramFiles\SecureWall\Attributions.txt" KeyPath="yes" />
          </Component>
          <Directory Id="LOCDIR_bg" Name="bg">
            <Component Id="LocSatelliteLib_bg" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_bg" Source="Sources\ProgramFiles\SecureWall\bg\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_es" Name="es">
            <Component Id="LocSatelliteLib_es" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_es" Source="Sources\ProgramFiles\SecureWall\es\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_cs" Name="cs">
            <Component Id="LocSatelliteLib_cs" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_cs" Source="Sources\ProgramFiles\SecureWall\cs\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_heIL" Name="he-IL">
            <Component Id="LocSatelliteLib_heIL" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_heIL" Source="Sources\ProgramFiles\SecureWall\he-IL\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_hu" Name="hu">
            <Component Id="LocSatelliteLib_hu" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_hu" Source="Sources\ProgramFiles\SecureWall\hu\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_fr" Name="fr">
            <Component Id="LocSatelliteLib_fr" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_fr" Source="Sources\ProgramFiles\SecureWall\fr\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_ja" Name="ja">
            <Component Id="LocSatelliteLib_ja" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_ja" Source="Sources\ProgramFiles\SecureWall\ja\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_de" Name="de">
            <Component Id="LocSatelliteLib_de" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_de" Source="Sources\ProgramFiles\SecureWall\de\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_nl" Name="nl">
            <Component Id="LocSatelliteLib_nl" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_nl" Source="Sources\ProgramFiles\SecureWall\nl\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_ko" Name="ko">
            <Component Id="LocSatelliteLib_ko" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_ko" Source="Sources\ProgramFiles\SecureWall\ko\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_pl" Name="pl">
            <Component Id="LocSatelliteLib_pl" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_pl" Source="Sources\ProgramFiles\SecureWall\pl\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_ru" Name="ru">
            <Component Id="LocSatelliteLib_ru" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_ru" Source="Sources\ProgramFiles\SecureWall\ru\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_ptBR" Name="pt-BR">
            <Component Id="LocSatelliteLib_ptBR" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_ptBR" Source="Sources\ProgramFiles\SecureWall\pt-BR\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_it" Name="it">
            <Component Id="LocSatelliteLib_it" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_it" Source="Sources\ProgramFiles\SecureWall\it\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_tr" Name="tr">
            <Component Id="LocSatelliteLib_tr" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_tr" Source="Sources\ProgramFiles\SecureWall\tr\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_uk" Name="uk">
            <Component Id="LocSatelliteLib_uk" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_uk" Source="Sources\ProgramFiles\SecureWall\uk\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="LOCDIR_zh" Name="zh">
            <Component Id="LocSatelliteLib_zh" Guid="*" Win64="$(var.Win64)">
              <File Id="LocSatelliteDLL_zh" Source="Sources\ProgramFiles\SecureWall\zh\SecureWall.resources.dll" Vital="yes" KeyPath="yes" Checksum="yes" Assembly=".net" AssemblyApplication="SecureWallEXE" />
            </Component>
          </Directory>
          <Directory Id="DOCDIR" Name="doc">
            <Component Id="DocFAQComp" Win64="$(var.Win64)">
              <File Id="DocFAQFile" Source="Sources\ProgramFiles\SecureWall\doc\faq.html" Vital="yes" KeyPath="yes" Checksum="yes" />
            </Component>
            <Directory Id="DOCCSSDIR" Name="css">
              <Component Id="DocCss00Comp" Win64="$(var.Win64)">
                <File Id="DocCss00File" Source="Sources\ProgramFiles\SecureWall\doc\css\1140.css" Vital="yes" KeyPath="yes" Checksum="yes" />
              </Component>
              <Component Id="DocCss02Comp" Win64="$(var.Win64)">
                <File Id="DocCss02File" Source="Sources\ProgramFiles\SecureWall\doc\css\style.css" Vital="yes" KeyPath="yes" Checksum="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
      
      <!-- Machine data is created and seeded only by the SYSTEM /install guard.
           MSI must never follow or clean an unchecked pre-existing ProgramData tree. -->
      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="$(var.ProductName)">
          <Component Id="ProgramMenuDir" Guid="*" Win64="$(var.Win64)">
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue Root='HKCU' Key='Software\[ProductName]' Type='string' Value='' KeyPath='yes' />
            <Shortcut Id="ControllerShortcut" Icon="SecureWallIcon.exe" Directory="ProgramMenuDir" Name="SecureWall Controller" Target="[INSTALLDIR]SecureWall.exe">
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5" Value="KPados.SecureWall.Controller" /> <!-- System.AppUserModel.ID -->
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 12" Value="1" />                         <!-- System.AppUserModel.StartPinOption, http://support.microsoft.com/kb/2745126/en-us -->
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 8" Value="1" />                          <!-- System.AppUserModel.ExcludeFromShowInNewInstall -->
            </Shortcut>
            <Shortcut Id="DevelToolShortcut" Icon="SecureWallIcon.exe" Directory="ProgramMenuDir" Name="SecureWall Dev Helper" Arguments="/develtool" Target="[INSTALLDIR]SecureWall.exe">
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 5" Value="KPados.SecureWall.DevelTool" />  <!-- System.AppUserModel.ID -->
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 12" Value="1" />                         <!-- System.AppUserModel.StartPinOption, http://support.microsoft.com/kb/2745126/en-us -->
              <ShortcutProperty Key="{9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3}, 8" Value="1" />                          <!-- System.AppUserModel.ExcludeFromShowInNewInstall -->
            </Shortcut>
            <Shortcut Id="FAQShortcut" Directory="ProgramMenuDir" Name="FAQ" Target="[INSTALLDIR]doc\faq.html"/>
            <!-- <Shortcut Id="UninstallProduct"
                      Name="Uninstall SecureWall"
                      Target="[$(var.System32Dir)]msiexec.exe"
                      Arguments="/x [ProductCode]" /> -->
          </Component>
        </Directory>
      </Directory>

    </Directory>

    <!-- Registry. The MSI owns only these two values. The recovery journals and the
         upgrade marker below the same key belong to SecureWall.exe, which deletes the
         key at the end of an explicit removal once both journals are clear; an upgrade
         removes and rewrites only these values. Platform names the installed package
         for the architecture check above. -->
    <Component Id="RegistryKeys" Guid="*" Directory="INSTALLDIR" Win64="$(var.Win64)">
      <RegistryKey Root='HKLM' Key='Software\SecureWall'>
        <RegistryValue Type='string' Name='InstallDir' Value='[INSTALLDIR]'/>
        <RegistryValue Type='string' Name='Platform' Value='$(var.BuildArch)'/>
      </RegistryKey>
    </Component>

    <!-- Application event log source for one-line maintenance and data-guard failure
         reasons. EXE custom actions discard stderr; the source needs no ProgramData path.
         Registry rows are written before InstallCustom and removed after UninstallCustom. -->
    <PropertyRef Id="NETFRAMEWORK40FULLINSTALLROOTDIR" />
    <Component Id="EventLogSource" Guid="*" Directory="INSTALLDIR" Win64="$(var.Win64)">
      <util:EventSource Name="SecureWall" Log="Application" EventMessageFile="[NETFRAMEWORK40FULLINSTALLROOTDIR]EventLogMessages.dll" KeyPath="yes" />
    </Component>

    <!-- Icons -->
    <Icon Id="SecureWallIcon.exe" SourceFile="Sources\ProgramFiles\SecureWall\SecureWall.ico" />

    <!-- Dependencies groupping -->
    <ComponentGroup Id="Dependencies">
      <ComponentRef Id="Microsoft_Bcl_AsyncInterfaces_Lib"/>
      <ComponentRef Id="System_Buffers_Lib"/>
      <ComponentRef Id="System_IO_Pipelines_Lib"/>
      <ComponentRef Id="System_Memory_Lib"/>
      <ComponentRef Id="System_Numerics_Vectors_Lib"/>
      <ComponentRef Id="System_Runtime_CompilerServices_Unsafe_Lib"/>
      <ComponentRef Id="System_Text_Encodings_Web_Lib"/>
      <ComponentRef Id="System_Text_Json_Lib"/>
      <ComponentRef Id="System_Threading_Tasks_Extensions_Lib"/>
    </ComponentGroup>

    <!-- Localization groupping -->
    <ComponentGroup Id="Localizations">
      <ComponentRef Id="LocSatelliteLib_bg"/>
      <ComponentRef Id="LocSatelliteLib_es"/>
      <ComponentRef Id="LocSatelliteLib_cs"/>
      <ComponentRef Id="LocSatelliteLib_heIL"/>
      <ComponentRef Id="LocSatelliteLib_hu"/>
      <ComponentRef Id="LocSatelliteLib_fr"/>
      <ComponentRef Id="LocSatelliteLib_ja"/>
      <ComponentRef Id="LocSatelliteLib_de"/>
      <ComponentRef Id="LocSatelliteLib_nl"/>
      <ComponentRef Id="LocSatelliteLib_ko"/>
      <ComponentRef Id="LocSatelliteLib_ru"/>
      <ComponentRef Id="LocSatelliteLib_it"/>
      <ComponentRef Id="LocSatelliteLib_uk"/>
      <ComponentRef Id="LocSatelliteLib_zh"/>
      <ComponentRef Id="LocSatelliteLib_ptBR"/>
      <ComponentRef Id="LocSatelliteLib_pl"/>
      <ComponentRef Id="LocSatelliteLib_tr"/>
    </ComponentGroup>

    <!-- Documentation groupping -->
    <ComponentGroup Id="Documentation">
      <ComponentRef Id="DocFAQComp"/>
      <ComponentRef Id="DocCss00Comp"/>
      <ComponentRef Id="DocCss02Comp"/>
    </ComponentGroup>
    
  </Fragment>

</Wix>
