<!--
SecureWall setup flow. Every page the user steps through is SecureWall's own:

First install:
 - SecureWallWelcomeDlg
 - SecureWallChecklistDlg (local install, fail-closed behavior, Windows Firewall)
 - SecureWallReadyDlg (license notice; SecureWallLicenseDlg shows the full text)
 - SecureWallProgressDlg
 - SecureWallExitDlg, SecureWallCancelledDlg or SecureWallFatalError

There is no maintenance flow: launch conditions reject repair, change and
upgrade, and removal from Settings > Apps sets REMOVE=ALL, which skips the
welcome pages. Stock WixUI dialogs remain only for Windows Installer prompts
that apply as-is: cancel confirmation, errors, files in use, disk space and
the initial preparing screen. Privileged code is supported only under protected
Program Files, so there is no directory chooser.
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <UI Id="WixUI_InstallDir_Custom">
            <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
            <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

            <DialogRef Id="ErrorDlg" />
            <DialogRef Id="SecureWallFatalError" />
            <DialogRef Id="FilesInUse" />
            <DialogRef Id="MsiRMFilesInUse" />
            <DialogRef Id="PrepareDlg" />
            <DialogRef Id="SecureWallProgressDlg" />
            <DialogRef Id="SecureWallExitDlg" />

            <Publish Dialog="SecureWallWelcomeDlg" Control="Next" Event="NewDialog" Value="SecureWallChecklistDlg">1</Publish>

            <Publish Dialog="SecureWallChecklistDlg" Control="Back" Event="NewDialog" Value="SecureWallWelcomeDlg">1</Publish>
            <Publish Dialog="SecureWallChecklistDlg" Control="Next" Event="NewDialog" Value="SecureWallReadyDlg">1</Publish>

            <Publish Dialog="SecureWallReadyDlg" Control="Back" Event="NewDialog" Value="SecureWallChecklistDlg">1</Publish>

            <Property Id="ARPNOMODIFY" Value="1" />
        </UI>

        <UIRef Id="WixUI_Common" />
    </Fragment>
</Wix>
